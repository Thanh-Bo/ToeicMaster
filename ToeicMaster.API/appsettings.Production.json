{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "${DATABASE_URL}"
  },
  "Gemini": {
    "ApiKey": "${GEMINI_API_KEY}"
  },
  "Google": {
    "CredentialsPath": "/etc/google-tts-key.json"
  },
  "AWS": {
    "AccessKey": "${AWS_ACCESS_KEY}",
    "SecretKey": "${AWS_SECRET_KEY}",
    "S3": {
      "BucketName": "toeicmaster-audio",
      "Region": "ap-southeast-2"
    }
  },
  "Jwt": {
    "Key": "${JWT_KEY}",
    "Issuer": "https://api.luyendetoeic.online",
    "Audience": "https://luyendetoeic.online"
  },
  "EmailSettings": {
    "FromEmail": "${EMAIL_FROM}",
    "SenderName": "Toeic Master Support",
    "AppPassword": "${EMAIL_PASSWORD}",
    "SmtpHost": "smtp.gmail.com",
    "SmtpPort": 587
  },
  "MoMo": {
    "Enabled": true,
    "SandboxMode": false,
    "PartnerCode": "${MOMO_PARTNER_CODE}",
    "AccessKey": "${MOMO_ACCESS_KEY}",
    "SecretKey": "${MOMO_SECRET_KEY}",
    "Endpoint": "https://payment.momo.vn/v2/gateway/api/create",
    "ReturnUrl": "https://luyendetoeic.online/payment-result",
    "NotifyUrl": "https://api.luyendetoeic.online/api/v1/payment/momo-callback"
  }
}
